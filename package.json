{
  "name": "tmphotos",
  "version": "0.1.0",
  "description": "Find and extract photos from old macOS Time Machine backups (HFS+ .sparsebundle and APFS .backupbundle), read-only.",
  "type": "module",
  "bin": {
    "tmphotos": "bin/tmphotos.js"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:unit": "node --test --test-name-pattern='^(?!integration)' test/*.test.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check && npm test"
  },
  "engines": {
    "node": ">=22.13"
  },
  "os": [
    "darwin"
  ],
  "keywords": [
    "time-machine",
    "sparsebundle",
    "backupbundle",
    "photos",
    "iphoto",
    "recovery",
    "macos",
    "hdiutil",
    "exif"
  ],
  "author": "Nick Hart",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nickhart/tmphotos.git"
  },
  "bugs": {
    "url": "https://github.com/nickhart/tmphotos/issues"
  },
  "homepage": "https://github.com/nickhart/tmphotos#readme",
  "dependencies": {
    "commander": "^15.1.0",
    "exifr": "^7.1.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1"
  }
}
